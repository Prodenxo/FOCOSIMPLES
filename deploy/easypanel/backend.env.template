# Cole no Easypanel → Serviço focosimples-api → Environment
# Troque TODOS os valores entre <...>

NODE_ENV=production
PORT=3333
APP_PRODUCT=focosimples

AUTH_MODE=local
DATABASE_URL=postgres://postgres:<SENHA_DB>@focosimples-db:5432/focosimples?sslmode=disable
AUTH_JWT_SECRET=<GERE_64_CHARS_ALEATORIOS>
DB_BOOTSTRAP_AUTO_SCHEMA=false
DB_BOOTSTRAP_FAIL_FAST=false
DB_BOOTSTRAP_SSL=false

# URLs públicas — frontend em focosimples.com.br
CORS_ORIGIN=https://focosimples.com.br,https://www.focosimples.com.br
FRONTEND_URL=https://focosimples.com.br
INVITE_APP_BASE_URL=https://focosimples.com.br

# Certificado A1 dos clientes (MESMO valor do dev — senão certificados cifrados quebram)
MEI_CERT_ENCRYPTION_KEY=<COPIE_DO_SEU_ENV_LOCAL>

# PlugNotas
PLUGNOTAS_API_BASE_URL=https://api.plugnotas.com.br
PLUGNOTAS_API_KEY=<TOKEN_PLUGNOTAS>
PLUGNOTAS_WEBHOOK_TOKEN=<TOKEN_WEBHOOK>
PLUGNOTAS_WEBHOOK_REQUIRE_TOKEN=true

# NF-e — responsável técnico (infRespTec). Obrigatório em vários estados.
# CNPJ/nome reutilizam SERPRO_CONTRATANTE_* se NFE_RESPONSAVEL_TECNICO_CNPJ/NOME omitidos.
# SERPRO_CERT_PFX_BASE64 NÃO entra aqui — é mTLS do Integra Contador (DAS), não infRespTec da NF-e.
# Falta só e-mail + telefone (obrigatórios na SEFAZ). Sem eles, usa padrão Tecnospeed/PlugNotas.
# NFE_RESPONSAVEL_TECNICO_EMAIL=contato@cfcontabilidade.com.br
# NFE_RESPONSAVEL_TECNICO_DDD=21
# NFE_RESPONSAVEL_TECNICO_TELEFONE=999999999

# SERPRO / Integra Contador (DAS Simples)
SERPRO_API_BASE_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1
SERPRO_OAUTH_TOKEN_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
SERPRO_OAUTH_TOKEN_NO_MTLS=false
SERPRO_CONSUMER_KEY=<SERPRO_KEY>
SERPRO_CONSUMER_SECRET=<SERPRO_SECRET>
SERPRO_ROLE_TYPE=TERCEIROS
SERPRO_CERT_PFX_BASE64=<BASE64_PFX_CONTRATANTE>
SERPRO_CERT_PFX_PASS=<SENHA_PFX>
SERPRO_CONTRATANTE_NUMERO=<CNPJ14_CONTRATANTE>
SERPRO_CONTRATANTE_NOME=<RAZAO_SOCIAL>
SERPRO_CONTRATANTE_TIPO=2
SERPRO_AUTOR_NUMERO=<CNPJ14_AUTOR>
SERPRO_AUTOR_TIPO=2
SERPRO_ASSINADO_POR_NOME=<NOME_ASSINANTE>

# IBPT (transparência NF-e)
IBPT_API_TOKEN=<TOKEN_IBPT>
IBPT_TIMEOUT_MS=12000

# Fiscal Engine v3.1 — OFF por padrão (motor legado permanece ativo)
FISCAL_ENGINE_V3=false

# Google Calendar (opcional)
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://<URL_BACKEND>/api/google-calendar/oauth-callback
