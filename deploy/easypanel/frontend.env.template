# Cole no Easypanel → focosimples-web → Environment (NÃO use Build Args)
#
# Exemplo com serviço backend "focosimplesbackend":
#   EXPO_PUBLIC_MEI_API_URL=https://auto-focosimplesbackend.4tnf3f.easypanel.host
#
# Depois que este frontend subir, copie a URL pública dele em INVITE_APP_BASE_URL
# e atualize CORS no backend (ver CADASTRO.md §4).

EXPO_PUBLIC_AUTH_MODE=local
EXPO_PUBLIC_APP_PRODUCT=focosimples
EXPO_PUBLIC_MEI_API_URL=https://<URL_BACKEND>.easypanel.host
EXPO_PUBLIC_INVITE_APP_BASE_URL=https://<URL_FRONTEND>.easypanel.host
